# คัดลอกไฟล์นี้เป็น .env แล้วปรับค่าตามจริง (ไฟล์ .env จะไม่ถูก commit/แชร์ เพราะมีความลับ เช่น รหัสผ่านอีเมล)

PORT=3000

# ที่อยู่ NAS สำหรับสำรองข้อมูล (UNC path หรือ mapped drive บน Windows)
# ตัวอย่าง: NAS_BACKUP_PATH=\\192.168.3.12\school-docsystem-backups
# หรือถ้า map เป็น drive แล้ว: NAS_BACKUP_PATH=Z:\school-docsystem-backups
NAS_BACKUP_PATH=\\192.168.3.12\Doc_Backup\docsystem

# ตั้งเวลาสำรองข้อมูลอัตโนมัติ (ค่าเริ่มต้น 02:00 น.)
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=365

# หลังสำรองข้อมูล ระบบจะส่งอีเมลรายงาน + รีสตาร์ทพอร์ตเว็บ 1 รอบตามเวลานี้ (ค่าเริ่มต้น = BACKUP_HOUR + 1 ชม.)
RESTART_HOUR=3
NIGHTLY_RESTART_ENABLED=true

# ตั้งค่า SMTP เพื่อให้ระบบส่งอีเมลรายงานผลสำรองข้อมูลได้ (ถ้าไม่ตั้งค่า ระบบจะข้ามการส่งอีเมลอย่างปลอดภัย)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=aphisorn.s@srinakorn.ac.th
SMTP_PASS=kbff fxkk vewi asfy
SMTP_FROM=ahisorn.s@srinakorn.ac.th
BACKUP_REPORT_EMAIL=ahisorn.s@srinakorn.ac.th

# origin ของ Vite dev server (ใช้ตอนพัฒนาเท่านั้น ไม่มีผลตอน build จริง)
DEV_CORS_ORIGIN=http://localhost:5173

# HTTPS (จำเป็นสำหรับ PWA Push Notification บนโดเมนจริง — เบราว์เซอร์บังคับ)
# ถ้าไม่ตั้งค่า ระบบจะรันเป็น HTTP ธรรมดา (ใช้ได้ปกติถ้ามี reverse proxy เช่น IIS/Nginx/Caddy ทำ HTTPS ให้อยู่แล้ว)
SSL_CERT_PATH=
SSL_KEY_PATH=
SSL_CA_PATH=

# Web Push (PWA Notification) — สร้างคีย์ด้วย: node scripts/generate-vapid-keys.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:aphisorn.s@srinakorn.ac.th

